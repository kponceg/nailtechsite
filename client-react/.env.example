# Values prefixed with VITE_ are public and included in browser code.
VITE_API_URL=http://localhost:5001

# Square browser SDK identifiers are public. Never put a Square access token here.
VITE_SQUARE_ENVIRONMENT=sandbox
VITE_SQUARE_APPLICATION_ID=replace_with_square_sandbox_application_id
VITE_SQUARE_LOCATION_ID=replace_with_square_location_id
